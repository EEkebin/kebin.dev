# Copied to /srv/media/.env by bootstrap.sh with random values. Never commit the real file.
# Every password is generated with: openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 20

# Nextcloud
NC_DB_PASSWORD=        # Postgres password used by the nextcloud container
NC_ADMIN_PASSWORD=     # Nextcloud admin login (user: $ADMIN_USER)

# Web UIs
FB_ADMIN_PASSWORD=     # FileBrowser Quantum admin
QBT_PASSWORD=          # qBittorrent web UI (also stored in each *arr download client)
JF_ADMIN_PASSWORD=     # Jellyfin admin; Seerr signs in with this account
ND_ADMIN_PASSWORD=     # Navidrome admin
ARR_PASSWORD=          # Sonarr, Radarr, Lidarr, Prowlarr, Bazarr forms login

# Username used for every service above
JF_ADMIN_USER=admin
