[Unit]
Description=archive.org helper for the download portal, :8097 (/srv/media/ia-queue.py)
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /srv/media/ia-queue.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/media-ia-queue.log
StandardError=append:/var/log/media-ia-queue.log

[Install]
WantedBy=multi-user.target
