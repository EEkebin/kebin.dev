[Unit]
Description=Weekly image update for the media stack (/srv/media/update.sh)
After=network-online.target mnt-storage.mount
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/srv/media/update.sh
StandardOutput=append:/var/log/media-update.log
StandardError=append:/var/log/media-update.log
TimeoutStartSec=2h
