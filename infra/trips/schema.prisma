generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model User {
  id Int @id @default(autoincrement())
  username String @unique
  email String @unique
  passwordHash String
  trip String?
  sessions Session[]
}
model Session {
  tokenHash String @id
  expires DateTime
  userId Int
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
