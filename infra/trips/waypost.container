[Unit]
Description=Waypost travel planner API
After=network-online.target waypost-db.service
Requires=waypost-db.service

[Container]
Image=localhost/waypost:latest
ContainerName=waypost
PublishPort=10.0.10.30:8197:8197
Network=waypost-net.network
EnvironmentFile=%h/.config/waypost/api.env
NoNewPrivileges=true

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
