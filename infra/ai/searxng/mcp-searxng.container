[Unit]
Description=mcp-searxng (MCP web search over the local SearXNG, streamable HTTP on 0.0.0.0:8899, reachable from the web VM for search.kebin.dev)
After=network-online.target searxng.service
Wants=searxng.service

[Container]
Image=docker.io/isokoliuk/mcp-searxng:latest
ContainerName=mcp-searxng
Network=host
Environment=SEARXNG_URL=http://127.0.0.1:8888
Environment=MCP_HTTP_PORT=8899
AutoUpdate=registry
Environment=MCP_HTTP_HOST=0.0.0.0
Environment=MCP_HTTP_TRUST_PROXY=true
Environment=MCP_HTTP_ALLOWED_HOSTS=search.kebin.dev,localhost,127.0.0.1,10.0.10.100

[Service]
Restart=always

[Install]
WantedBy=default.target
