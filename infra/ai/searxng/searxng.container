[Unit]
Description=SearXNG local search
After=network-online.target

[Container]
Image=docker.io/searxng/searxng:latest
ContainerName=searxng
PublishPort=8888:8080
Volume=/home/user/llama/searxng:/etc/searxng:z
Environment=SEARXNG_BASE_URL=https://search.kebin.dev/
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
