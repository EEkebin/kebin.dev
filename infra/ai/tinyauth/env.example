# Copy to ~/.config/tinyauth/env on the ai VM (chmod 600). Never commit the real file.
TINYAUTH_SERVER_PORT=3000
TINYAUTH_SERVER_ADDRESS=0.0.0.0
TINYAUTH_APPURL=https://auth.kebin.dev
# htpasswd -nbB admin '<password>'  ->  admin:$2y$...
TINYAUTH_AUTH_USERS=admin:<bcrypt hash>
# openssl rand -hex 16
TINYAUTH_SECRET=<32 hex chars>
TINYAUTH_AUTH_SECURECOOKIE=true
TINYAUTH_AUTH_TRUSTEDPROXIES=10.0.10.20
TINYAUTH_AUTH_SESSIONEXPIRY=604800
TINYAUTH_DATABASE_PATH=/data/tinyauth.db
