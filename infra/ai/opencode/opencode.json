{
  "$schema": "https://opencode.ai/config.json",
  "model": "aibox/qwen3.8-27b",
  "provider": {
    "aibox": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "aibox (llama-swap on the media VM, 3x V100)",
      "options": {
        "baseURL": "http://10.0.10.30:8086/v1",
        "apiKey": "local"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B Q8 (vision, 262K, 3x V100)",
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "searxng": {
      "type": "remote",
      "url": "http://127.0.0.1:8899/mcp",
      "oauth": false,
      "enabled": true,
      "timeout": 60000
    }
  },
  "permission": {
    "webfetch": "allow",
    "websearch": "deny",
    "searxng_*": "allow",
    "external_directory": "ask"
  }
}
