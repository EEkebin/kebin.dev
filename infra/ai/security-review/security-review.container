[Unit]
Description=Security Review report uploader
[Container]
Image=localhost/security-review:1
ContainerName=security-review
PublishPort=10.0.10.100:8097:8097
EnvironmentFile=%h/.config/security-review.env
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
PodmanArgs=--memory=256m --pids-limit=64
[Service]
Restart=on-failure
[Install]
WantedBy=default.target
