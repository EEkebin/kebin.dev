[Unit]
Description=Humanizer page (draft -> rewrite via the humanizer model in llama-swap) on :8095
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/user/.local/share/humanizer/humanizer.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
